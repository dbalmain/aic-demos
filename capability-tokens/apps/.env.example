# Copy to apps/.env (gitignored). The values are the same secrets as the
# repo-root .env, plus where the apps listen.
CAPTOKEN_TENANT_URL=https://<your-tenant>.forgeblocks.com
CAPTOKEN_REALM=bravo
CAPTOKEN_POLICY_SET=CapTokenDemo
CAPTOKEN_REGISTER_TREE=CapTokenDemoRegister

CAPTOKEN_LOGIN_CLIENT_ID=CapTokenDemo_web
CAPTOKEN_LOGIN_CLIENT_SECRET=
CAPTOKEN_CALLER_CLIENT_ID=CapTokenDemo_caller
CAPTOKEN_CALLER_CLIENT_SECRET=

# How shop-api authenticates to the policy endpoint. Reaching
# ?_action=evaluate needs a service-account bearer — a realm OAuth2 client's
# client_credentials token is refused even holding fr:am:* — so either supply
# one, or let the API borrow the local aic agent's for development.
# CAPTOKEN_API_BEARER=
CAPTOKEN_AIC_PROJECT=../../pingone-aic-manager

CAPTOKEN_WEB_PORT=8790
CAPTOKEN_API_PORT=8791
CAPTOKEN_API_URL=http://127.0.0.1:8791
CAPTOKEN_API_AUDIENCE=https://shop-api.demo:443
