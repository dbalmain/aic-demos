# Copy to .env (gitignored) and fill in the blanks.
#
# aic resolves its tenant from .aic/config.toml in the *current directory*, so
# the helper scripts run it from AIC_PROJECT_DIR. Point that at your
# pingone-aic-manager clone. The tenant hostname is customer-identifying and
# must never land in this repo.
AIC_PROJECT_DIR=../../pingone-aic-manager

CAPTOKEN_REALM=bravo

# Chosen by you; provision.sh sets them on the clients it creates.
CAPTOKEN_LOGIN_CLIENT_ID=CapTokenDemo_web
CAPTOKEN_LOGIN_CLIENT_SECRET=
CAPTOKEN_CALLER_CLIENT_ID=CapTokenDemo_caller
CAPTOKEN_CALLER_CLIENT_SECRET=
CAPTOKEN_DEMO_PASSWORD=
