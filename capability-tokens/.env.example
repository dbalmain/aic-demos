# Copy to .env (gitignored) and fill in the blanks, then SOURCE it — the
# helper scripts read it themselves, but the terraform step in README.md
# needs the values in your own shell:
#
#   cp .env.example .env && $EDITOR .env
#   set -a && . ./.env && set +a          # sh/bash; fish users: see README
#
# aic resolves its tenant from a project directory: the current one by
# default, or AIC_PROJECT when set. This repo is not one, so point AIC_PROJECT
# at your pingone-aic-manager clone — wherever it lives. Nothing here assumes
# the two are siblings; this variable is the whole of the coupling. The tenant
# hostname is customer-identifying and must never land in this repo, which is
# the other reason the config stays over there.
#
# Use an ABSOLUTE path: the scripts export this for `aic`, and a relative one
# resolves against whatever directory you happened to run from.
AIC_PROJECT=/absolute/path/to/pingone-aic-manager

# The base URL of the tenant this demo owns, e.g. https://<your-tenant>.forgeblocks.com
# Take it from `aic ctx list` rather than typing it. The scripts refuse to run
# when the active aic context does not match this: AIC_PROJECT picks a project,
# but `aic ctx use` decides which tenant inside it is current, and these
# scripts delete records by fixed id.
CAPTOKEN_TENANT_URL=

CAPTOKEN_REALM=bravo

# Chosen by you; provision.sh sets them on the clients it creates.
CAPTOKEN_LOGIN_CLIENT_ID=CapTokenDemo_web
CAPTOKEN_LOGIN_CLIENT_SECRET=
CAPTOKEN_CALLER_CLIENT_ID=CapTokenDemo_caller
CAPTOKEN_CALLER_CLIENT_SECRET=
CAPTOKEN_DEMO_PASSWORD=
