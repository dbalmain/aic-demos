# Copy to .env (gitignored) and fill in the blanks, then SOURCE it — the
# helper scripts read it themselves, but the terraform step in README.md
# needs the values in your own shell:
#
#   cp .env.example .env && $EDITOR .env
#   set -a && . ./.env && set +a          # sh/bash; fish users: see README
#
# aic resolves its tenant from a project directory: the current one by
# default, or AIC_PROJECT when set. This repo is not one, so point AIC_PROJECT
# at your pingone-aic-manager clone — wherever it lives. Nothing here assumes
# the two are siblings; this variable is the whole of the coupling. The tenant
# hostname is customer-identifying and must never land in this repo, which is
# the other reason the config stays over there.
#
# Use an ABSOLUTE path: the scripts export this for `aic`, and a relative one
# resolves against whatever directory you happened to run from.
AIC_PROJECT=/absolute/path/to/pingone-aic-manager

TXNDEMO_REALM=bravo
# The tenant's base URL, e.g. https://<your-tenant>.forgeblocks.com — take it
# from `aic ctx list` rather than typing it.
TXNDEMO_TENANT_URL=

# Chosen by you; terraform apply sets them on the clients it creates. Any
# reasonably strong string will do — nothing external has to agree with them.
TXNDEMO_WEB_CLIENT_ID=TxnDemo_web
TXNDEMO_WEB_CLIENT_SECRET=
TXNDEMO_JOBSVC_CLIENT_ID=TxnDemo_jobsvc
TXNDEMO_JOBSVC_CLIENT_SECRET=
TXNDEMO_CALLER_CLIENT_ID=TxnDemo_caller
TXNDEMO_CALLER_CLIENT_SECRET=

# scripts/seed.sh sets these on the two seeded identities, on FIRST run only —
# it never re-sends a password, because the realm's password history refuses
# the one already stored. If the records already exist with different
# passwords, use scripts/reset-password.sh.
#
# The realm enforces a password policy: mixed case, a digit and a symbol.
TXNDEMO_ALICE_PASSWORD=
TXNDEMO_JOBSVC_PASSWORD=

# Everything below is OPTIONAL — defaults are fine, and the values the apps
# actually read are written to apps/.env by scripts/write-env.sh.
#
# The client IDs above must match what Terraform creates. If you change one,
# pass the matching TF_VAR too (TF_VAR_web_client_id, ...), or Terraform will
# create the default-named client while the scripts address yours.
#
# TXNDEMO_PORTAL_PORT=9000
# TXNDEMO_ACTIVITY_API_PORT=9002
# TXNDEMO_LEDGER_PORT=9003
