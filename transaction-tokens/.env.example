# Copy to .env (gitignored) and fill in the blanks.
#
# aic resolves its tenant from .aic/config.toml in the *current directory*, so
# the helper scripts run it from AIC_PROJECT_DIR. Point that at your
# pingone-aic-manager clone. The tenant hostname is customer-identifying and
# must never land in this repo.
AIC_PROJECT_DIR=../../pingone-aic-manager

TXNDEMO_REALM=bravo
TXNDEMO_TENANT_URL=

# Chosen by you; terraform apply sets them on the clients it creates.
TXNDEMO_WEB_CLIENT_ID=TxnDemo_web
TXNDEMO_WEB_CLIENT_SECRET=
TXNDEMO_JOBSVC_CLIENT_ID=TxnDemo_jobsvc
TXNDEMO_JOBSVC_CLIENT_SECRET=
TXNDEMO_CALLER_CLIENT_ID=TxnDemo_caller
TXNDEMO_CALLER_CLIENT_SECRET=

# scripts/seed.sh sets these on the two seeded identities.
TXNDEMO_ALICE_PASSWORD=
TXNDEMO_JOBSVC_PASSWORD=
