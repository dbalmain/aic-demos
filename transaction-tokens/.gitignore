# Terraform local state and provider cache. The state names tenant objects and
# holds the client secrets in plaintext; it is not something to commit.
terraform/.terraform/
terraform/.terraform.lock.hcl
terraform/*.tfstate
terraform/*.tfstate.*
terraform/*.tfvars

# Live evidence capture. A HAR or a raw response body is the usual way a
# client's hostname reaches a repo (pingone-aic-manager .ai/core.md §3).
*.har
